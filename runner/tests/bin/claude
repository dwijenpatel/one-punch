#!/bin/zsh
# claude shim for runner.py mock tests. Reads the -p prompt (argv[2]),
# fakes the minimal side effects each stage needs, prints a result JSON.
# Mimics real headless behavior: without --dangerously-skip-permissions
# (or with CLAUDE_SHIM_DENY=1), permission-gated work silently does NOT
# happen and the session still exits 0 — the measured live failure mode.
if [[ " $* " != *" --dangerously-skip-permissions "* || -n "$CLAUDE_SHIM_DENY" ]]; then
  print '{"total_cost_usd":0.01,"num_turns":1,"duration_api_ms":100,"permission_denials":[{"tool_name":"Write"},{"tool_name":"Bash"}],"usage":{"input_tokens":1,"output_tokens":1}}'
  exit 0
fi
prompt="$2"
case "$prompt" in
  Read*)  # planner: emit CLAUDE.md, specs/, tasks.json (left dirty on purpose)
    print "conventions: stdlib only" > CLAUDE.md
    mkdir -p specs
    print "# t1 spec — write hello.py printing hello" > specs/t1.md
    print '[{"id":"t1","spec":"specs/t1.md","checks":["test -f hello.py"]}]' > tasks.json
    ;;
  /plan-review*)  # reviewer: amend a spec + write the report
    print "PINNED: hello means exactly hello (not Hello)" >> specs/t1.md
    print "# plan-review report: 1 confirmed finding" > plan-review-report.md
    ;;
  Implement*)  # implementer: create the artifact the check wants (left dirty)
    # Status contract: extract the status path the prompt pins, honor it the
    # way the shim's mode dictates (obedient / blocked / liar).
    sp=$(print -r -- "$prompt" | grep -oE '\.runner/status/[^" ]+\.json' | head -1)
    if [[ -n "$CLAUDE_SHIM_BLOCK" ]]; then
      [[ -n "$sp" ]] && mkdir -p "${sp:h}" && \
        print '{"task":"t1","outcome":"blocked","blocked_reason":"spec contradicts CLAUDE.md rule 3"}' > "$sp"
    elif [[ -n "$CLAUDE_SHIM_LIAR" ]]; then
      [[ -n "$sp" ]] && mkdir -p "${sp:h}" && \
        print '{"task":"t1","outcome":"done"}' > "$sp"
    else
      print "print('hello')" > hello.py
      [[ -n "$sp" ]] && mkdir -p "${sp:h}" && \
        print '{"task":"t1","outcome":"done"}' > "$sp"
    fi
    ;;
  "You are a blind"*)  # oracle author: write the acceptance suite (clone cwd)
    mkdir -p oracle_tests
    : > oracle_tests/__init__.py
    if [[ -n "$CLAUDE_SHIM_ORACLE_RED" ]]; then
      print 'import unittest\nclass T(unittest.TestCase):\n    def test_criterion(self):\n        self.fail("acceptance criterion unmet")' > oracle_tests/test_oracle.py
    else
      print 'import unittest, os\nclass T(unittest.TestCase):\n    def test_hello_exists(self):\n        self.assertTrue(os.path.exists("hello.py"))' > oracle_tests/test_oracle.py
    fi
    ;;
  /code-review*|/simplify*)  # clean pass: no findings applied, tree untouched
    ;;
esac
print '{"total_cost_usd":0.01,"num_turns":2,"duration_api_ms":1000,"usage":{"input_tokens":10,"output_tokens":5,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}'
exit 0
